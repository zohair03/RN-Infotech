",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/\",\"className\":\"text-lg font-semibold text-gray-700 font-medium hover:text-primary transition-colors\",\"children\":\"Home\"}],[\"$\",\"$L4\",null,{\"src\":\"/icons/right-icon.svg\",\"alt\":\"Arrow Icon\",\"width\":20,\"height\":20}],null,[\"$\",\"span\",null,{\"className\":\"text-lg font-semibold text-primary font-medium\",\"children\":\"Privacy Policy\"}]]}]],[\"$\",\"section\",null,{\"className\":\"bg-gray-50 py-8 px-6 sm:px-8 lg:py-12 lg:px-16 2xl:px-35\",\"children\":[\"$\",\"div\",null,{\"children\":[\"$\",\"div\",null,{\"children\":[\"$\",\"div\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4 font-sans\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Privacy Policy\"}]}],[\"$\",\"p\",null,{\"children\":\"Last revised: June 4, 2025.\"}],[\"$\",\"p\",null,{\"children\":[\"This privacy policy ( \",[\"$\",\"strong\",null,{\"children\":\"\\\"Privacy Policy\\\"\"}],\") describes how TechSpace Singularity ( \",[\"$\",\"strong\",null,{\"children\":\"\\\"we\\\"\"}],\", or \",[\"$\",\"strong\",null,{\"children\":\"\\\"us\\\"\"}],\") collects, uses, shares, retains, and safeguards your Personal Information when you visit our website ( \",[\"$\",\"strong\",null,{\"children\":\"\\\"Site\\\"\"}],\"). It does not apply to any information we collect outside the Site or our other interactions with you.\"]}],[\"$\",\"p\",null,{\"children\":\"WE MAY MODIFY THIS PRIVACY POLICY AT ANY TIME, SO CHECK BACK REGULARLY FOR UPDATES. ALL CHANGES WILL BE EFFECTIVE IMMEDIATELY UPON POSTING TO THE SITE. WE WILL ATTEMPT TO NOTIFY YOU OF ANY MATERIAL CHANGES VIA THE SITE.\"}],[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"1. WHAT IS PERSONAL INFORMATION?\"}]]}],[\"$\",\"p\",null,{\"children\":[\"For purposes of this Privacy Policy,\",\" \",[\"$\",\"strong\",null,{\"children\":\"\\\"Personal Information\\\"\"}],\"means information that alone or in combination identifies, relates to, describes, is reasonably capable of being associated with, or could reasonably be linked, directly or indirectly, with a particular consumer or household. Personal information does not include deidentified or aggregated consumer information or information that is available in public records.\"]}],[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"2. CATEGORIES OF PERSONAL INFORMATION WE COLLECT\"}]]}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\"]}]}]}]}]}]],null,\"$L29\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"8e6P4LHD1lmpdVye2EESf\"}\n5:[\"$\",\"p\",null,{\"children\":[\"For purposes of this Privacy Policy,\",\" \",[\"$\",\"strong\",null,{\"children\":\"\\\"Personal Information\\\"\"}],\"means information that alone or in combination identifies, relates to, describes, is reasonably capable of being associated with, or could reasonably be linked, directly or indirectly, with a particular consumer or household. Personal information does not include deidentified or aggregated consumer information or information that is available in public records.\"]}]\n6:[\"$\",\"p\",null,{\"children\":\"We collect the following categories of Personal Information:\"}]\n7:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Identifiers\"}],\"such as your first and last name, Internet Protocol address, email address, and telephone number.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Commercial Information\"}],\"such as records of products or services purchased, including certain payment information.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Internet Activity\"}],\"such as your information about the device you are using, your browsing history and search history, information regarding your interactions with the Sites, electronic device identifier, hardware information, operating system version, access times and referring website URLs.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Geolocation Data\"}],\", which is imprecise location information, like the city, state and ZIP code associated with your IP address.\"]}]]}]\n8:[\"$\",\"p\",null,{\"children\":\"We may aggregate or de-identify Personal Information we collect through our Site. Any information or data that has been de-identified and/or aggregated so that it no longer contains Personal Information will not be treated as Personal Information (for example, we may aggregate Personal Information to calculate the percentage of users in a particular zip code).\"}]\n9:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"3. SOURCES OF PERSONAL INFORMATION\"}]]}]\na:[\"$\",\"p\",null,{\"children\":\"We obtain Personal Information from the following categories of sources:\"}]\nb:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Directly from you\"}],\". For example, when you sign up to receive a newsletter.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Indirectly from you\"}],\". For example, we receive certain information that your computer or mobile device transmits when you interact with our Site.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Third Parties\"}],\". We may collect Personal Information about you from third parties in a variety of ways, including, without limitation:\",\" \",[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":\"We may receive Personal Information about you from third parties that provide services to us, including our web hosting providers and payment providers.\"}],[\"$\",\"li\",null,{\"children\":\"We may receive Personal Information related to your use of our Site from third party analytics providers and advertising partners.\"}]]}]]}]]}]\nc:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"4. HOW WE USE PERSONAL INFORMATION\"}]]}]\nd:[\"$\",\"p\",null,{\"children\":\"The primary purposes for which we use Personal Information are:\"}]\ne:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Customer Service and Customer Communications.\"}],\"We may use Personal Information to (1) facilitate purchases, (2) respond to requests for information, (3) provide customer service, and (4) for those purposes in which you authorize or instruct us to use your Personal Information.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Business Purposes.\"}],\"We may use Personal Information for business purposes including but not limited to: (1) creating and servicing online accounts, (2) providing our Site, (3) providing information about our Site, (4) performing Site management and analytics, (5) research and development, (6) administering surveys and feedback, (7) conducting statistical or demographic analysis, (8) assessing the success of our marketing and advertising campaigns, (9) preventing fraud, (10) other business purposes permitted under applicable law, and (11) carrying out our obligations and enforcing our rights arising from any contracts we have entered into, including, without limitation, any contracts between you and us.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Marketing Purposes.\"}],\"We may use your Personal Information to serve you targeted advertisements and market to you including notifying you of special promotions, opportunities, offers and events via e-mail and other means.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Law Enforcement/Legal Purposes.\"}],\"We may use Personal Information to cooperate with law enforcement or other legal purposes including: (1) complying with legal and regulatory requirements; (2) satisfying contractual obligations; (3) cooperating with law enforcement or other governmental agencies for purposes of investigations, public safety or matters of public importance when we are legally required to do so or believe that disclosure of Personal Information is necessary or appropriate to protect the public interest; and (4) protecting and defending against legal actions or claims.\"]}]]}]\nf:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"5. WHO WE SHARE YOUR INFORMATION WITH\"}]]}]\n10:[\"$\",\"p\",null,{\"children\":\"To operate and provide our Site, we may share Personal Information with certain third parties. The third parties that we may share Personal Information with include:\"}]\n11:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Service Providers\"}],\". We may share Personal Information with service providers. For example, we may share Personal Information with vendors to help us host and manage our Site; improve the content and functionality of the Site; perform data analysis and statistical analysis; troubleshoot problems with the Site; provide email services; provide data processing; and support or provide the security of the Site.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Marketing and Advertising Vendors\"}],\". We may share Personal Information with marketing and advertising vendors to provide targeted advertising and other marketing communications.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Parties to Business Transactions\"}],\". In the event of an anticipated or actual merger or acquisition, bankruptcy or other sale of all or a portion of our assets, we may transfer or allow third parties to use information owned or controlled by us, including Personal Information. We reserve the right, in connection with these types of transactions, to transfer, share, assign, or sell your Personal Information and other information we have collected to third parties or to authorize such third parties to use any such information including for due diligence as part of any of the transactions described in this paragraph. Any Personal Information you submit or that is collected after this type of transfer may be subject to a new privacy policy adopted by the successor entity.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Government and Law Enforcement\"}],\". We may share your Personal Information with individuals or private parties where necessary to enforce and comply with the law, to protect our property or legal rights, for the safety of the public or any person, to prevent harm, to protect the security and integrity of the Site and any equipment used to make the Site available.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Professional Advisors\"}],\". We may share Personal Information with our professional advisors, such as our attorneys, accountants, financial advisors, and business advisors, in their capacity as advisors to us.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Other\"}],\". We may share Personal Information with third parties and/or service providers when explicitly requested by or consented to by you, or for the purposes for which you disclosed the Personal Information to us as indicated at the time and point of the disclosure (or as was obvious at the time and point of disclosure).\"]}]]}]\n12:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"6. YOUR CHOICES\"}]]}]\n13:[\"$\",\"p\",null,{\"children\":\"We recognize that you may want to limit how your Personal Information is used and shared. We currently offer the following choices and options:\"}]\n14:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Opt Out of Targeted Marketing.\"}],\"If you wish to limit or opt out of third-party advertising, you can do one or more of the following:\",\" \",[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"span\",null,{\"class\":\"underline\",\"children\":\"Change your Browser Settings\"}],\". The Options/Settings section of most internet browsers will tell you how to manage cookies and other technologies that may be uploaded to your device, including how to disable such technologies. You can disable our cookies, or all cookies, through your browser settings, but please note, disabling cookies may impact some of the features of our Site and prevent them from operating as intended. You can learn more about cookies, including how to see what cookies have been uploaded to your device and how to manage and delete them, by visiting\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.allaboutcookies.org\",\"raw_url\":\"https://www.allaboutcookies.org\",\"children\":\"All About Cookies\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"span\",null,{\"class\":\"underline\",\"children\":\"Change your Preferences\"}],\". To change your preferences with respect to certain online ads and to obtain more information about ad networks and online behavioral advertising visit the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://optout.networkadvertising.org/?c=1\",\"raw_url\":\"https://optout.networkadvertising.org/?c=1\",\"children\":\"National Advertising Initiative Consumer Opt Out page\"}],\"and the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://optout.aboutads.info/?c=2&lang=EN\",\"raw_url\":\"https://optout.aboutads.info/?c=2&lang=EN\",\"children\":\"Digital Advertising Alliance's Consumer Choice Tool\"}],\". Please note that even if you opt out of receiving interest-based advertising, you will still receive advertisements, but they will be more general in nature. In addition, the electronic device you use to visit our Site may offer relevant privacy settings; please see the device settings for details.\"]}]]}]]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Opt Out of Marketing Communications.\"}],\"You can opt out of marketing or advertising emails by clicking on the unsubscribe button in the email. To opt-out of other marketing communications, please contact us as set forth in the \\\"Contact Us\\\" section below.\"]}]]}]\n15:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"7. COOKIES AND OTHER TRACKING TECHNOLOGIES\"}]]}]\n16:[\"$\",\"p\",null,{\"children\":\"We use cookies and other tracking technologies including pixel tags and web beacons to gather more information about how the Site is used and for advertising purposes.\"}]\n17:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"About Cookies.\"}],\"A \\\"cookie\\\" is a small text file that our Site saves onto your computer or device when you use the Site that allows the Site to remember your actions and preferences and recognize you or your browser. Web beacons / pixel tags are small graphics on a webpage that monitor your activity when viewing a webpage. Generally, the type of information we collect through cookies and other tracking technologies is specific to your computer or other device and includes the IP address, date and time the device accessed our Site, what parts of our Site were visited, your internet services provider, the device ID number, approximate geographic location, browser type, the websites you visit before and after coming to our Site, and whether the web pages requested were delivered successfully.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Why we use Cookies.\"}],\"We use these tools to learn whether the Site is operating optimally, learn whether you are a repeat visitor to our Site, personalize advertising, obtain valuable data and statistics about the usage and effectiveness of our Site, and help us provide an enjoyable, personalized and innovative online experience for you. We may combine information gathered from cookies with other Personal Information.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Session Replay Tools.\"}],\"We may also use session replay tools. Session replay is the reproduction of a user's interactions on a website or web application exactly how the user actually experienced it. Session replay transforms logged user events, such as mouse movements, clicks, page visits, scrolling, tapping, etc., into a reproduction of what the user actually did on the site or app. We use session replay tools to gain a more complete picture of how users interact with our Site.\"]}]]}]\n18:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"8. ANALYTICS\"}]]}]\n19:[\"$\",\"p\",null,{\"children\":\"Our Site uses third-party cookies and analytics tools, including those listed below.\"}]\n1a:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Google Analytics.\"}],\"Google Analytics is a web analytics service provided by Google, Inc. ( \",[\"$\",\"strong\",null,{\"children\":\"\\\"Google\\\"\"}],\"), to assist us in understanding how our Site is used. Google Analytics will place cookies on your computer or mobile device that will generate information that we select about your use of the Site, including your computer's or mobile device's IP address. That information will be transmitted directly to and stored by Google. You may refuse the use of cookies by selecting the appropriate settings on your browser. The use of cookies by Google Analytics is covered by Google's privacy policy, available at\",\" \",[\"$\",\"a\",null,{\"href\":\"https://policies.google.com/privacy\",\"raw_url\":\"https://policies.google.com/privacy\",\"children\":\"Privacy Policy\"}],\". Google allows you to opt out of Google Analytics on their\",\" \",[\"$\",\"a\",null,{\"href\":\"https://tools.google.com/dlpage/gaoptout\",\"raw_url\":\"https://tools.google.com/dlpage/gaoptout\",\"children\":\"opt-out page\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Google Tag Manager.\"}],\"We may use Google Tag Manager ( \",[\"$\",\"strong\",null,{\"children\":\"\\\"GTM\\\"\"}],\"), a tag management system that allows JavaScript and HTML tags to be quickly deployed and updated on portions of our Site for tracking and analytics. We use GTM on our Site to include Google Analytics. If you have opted out of Google Analytics, GTM takes this opt out into account. For more information about Google's privacy practices applicable to GTM, please refer to Google's\",\" \",[\"$\",\"a\",null,{\"href\":\"https://policies.google.com/privacy\",\"raw_url\":\"https://policies.google.com/privacy\",\"children\":\"Privacy Policy\"}],\"and\",\" \",[\"$\",\"a\",null,{\"href\":\"https://marketingplatform.google.com/about/analytics/tag-manager/use-policy/\",\"raw_url\":\"https://marketingplatform.google.com/about/analytics/tag-manager/use-policy/\",\"children\":\"Terms of Use\"}],\".\"]}]]}]\n1b:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"9. INTEREST BASED ADVERTISING\"}]]}]\n1c:[\"$\",\"p\",null,{\"children\":\"We also use cookies and other third party tracking technologies to provide online behavioral advertising (also called \\\"targeted advertising\\\" or \\\"interest based advertising\\\") which is the practice of tracking an individual's online activities over time, including searches the person conducts, webpages visited and content viewed in order to deliver targeted advertising based on the person's interests. The data collected may contain, or be associated with, your Personal Information. These advertisements may appear on the Site and on other websites, or may be sent to you via email. Our Site uses third-party cookies and other similar tools for interest based advertising, including those listed below.\"}]\n1d:[\"$\",\"ul\",null,{\"children\":[\" \",[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Google Analytics' Advertising Features.\"}],\"We have enabled and implemented Google Analytics Advertising tools including [ \",[\"$\",\"span\",null,{\"class\":\"mark\",\"children\":\"DoubleClick\"}],\"]. To opt out of remarketing advertising provided through Google, to customize your ad preferences, or to limit Google's collection or use this information, visit\",\" \",[\"$\",\"a\",null,{\"href\":\"https://safety.google/\",\"raw_url\":\"https://safety.google/\",\"children\":\"Google's Safety Center\"}],\"and follow\",\" \",[\"$\",\"a\",null,{\"href\":\"https://support.google.com/ads/answer/2662922?hl=en&ref_topic=7048998\",\"raw_url\":\"https://support.google.com/ads/answer/2662922?hl=en&ref_topic=7048998\",\"children\":\"Google's personalized ad opt-out instructions\"}],\". Opting out will not affect your use of the Site.\"]}],[\"$\",\"li\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"Meta's Advertising Tools.\"}],\"We use remarketing services provided by Meta (previously Facebook) on our Site. We use the Meta Custom Audiences to deliver targeted advertisements to website visitors across Meta owned social media platforms, including Facebook and Instagram, based on email addresses that we have collected. You may learn more about Meta Custom Audiences by visiting the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.facebook.com/business/help/744354708981227?id=2469097953376494\",\"raw_url\":\"https://www.facebook.com/business/help/744354708981227?id=2469097953376494\",\"children\":\"About custom Audiences\"}],\"page. To learn more about Meta's Privacy Policy including their services and your rights, please see the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.facebook.com/privacy/policy/\",\"raw_url\":\"https://www.facebook.com/privacy/policy/\",\"children\":\"Facebook Privacy Policy\"}],\".\"]}]]}]\n1e:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"10. SOCIAL MEDIA\"}]]}]\n1f:[\"$\",\"p\",null,{\"children\":\"We are active on social media. The Site allows you to connect and share data with social media. These features may require us to use cookies, plug-ins, and APIs provided by such social media companies to facilitate those communications and features. The Site may also use advertising networks and services offered by social media companies to deliver advertising content. Use of these services requires the applicable social media company to implement cookies or pixel tags to deliver ads to you while you access the Site.\"}]\n20:[\"$\",\"p\",null,{\"children\":\"Your use of social media is governed by the privacy policies and terms of the third parties that own and operate those websites and not by this Privacy Policy. We encourage you to review those policies and terms before using any social media features provided through our Site or third-party websites.\"}]\n21:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"11. CHILDREN\"}]]}]\n22:[\"$\",\"p\",null,{\"children\":\"The Site is not directed at children under 13 years of age. We do not knowingly collect, use, share or sell Personal Information from children under 13. If a parent or legal guardian learns that their child provided us with Personal Information without his or her consent, please contact us and we will make commercially reasonable attempts to delete such Personal Information.\"}]\n23:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"12. THIRD-PARTY WEBSITES\"}]]}]\n24:[\"$\",\"p\",null,{\"children\":\"The Site may link to, or be linked to, websites that we do not own or control. We are not responsible for the privacy policies or practices of any third parties or any third-party websites. This Privacy Policy does not apply to any third-party websites or to any Personal Information that you may provide to third parties. You should read the privacy policy for each website that you visit.\"}]\n25:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"13. CALIFORNIA SHINE THE LIGHT\"}]]}]\n26:[\"$\",\"p\",null,{\"children\":\"Pursuant to California Civil Code Section 1798.83, if you are a California resident, you have the right to obtain: (a) a list of all third parties to whom we may have disclosed your Personal Information within the past year for direct marketing purposes, and (b) a description of the categories of Personal Information disclosed, by contacting us per the \\\"Contact Us\\\" Section below.\"}]\n27:[\"$\",\"p\",null,{\"children\":[\" \",[\"$\",\"strong\",null,{\"children\":\"14. CONTACT US\"}]]}]\n28:[\"$\",\"p\",null,{\"children\":\"If you have any questions, comments or requests regarding this Policy, please contact us using the contact information shown on our Site.\"}]\n29:[\"$\",\"$L2a\",null,{\"children\":[\"$\",\"$2b\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2c\"}]}]\n2c:null\n","/privacy-policy":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/0izx~ogmoekpp.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/1357rt.wiwq02.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/0izx~ogmoekpp.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/1357rt.wiwq02.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\